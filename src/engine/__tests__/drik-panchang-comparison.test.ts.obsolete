// ---------------------------------------------------------------------------
// Comparison helper
// ---------------------------------------------------------------------------

function fmtTime(d: Date): string {
  return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
}

/**
 * Get the TITHI_NAMES array that the engine uses.
 * This MUST match src/engine/constants.ts
 */
const TITHI_NAMES = [
  'Pratipada', 'Dwitiya', 'Tritiya', 'Chaturthi', 'Panchami',
  'Shashthi', 'Saptami', 'Ashtami', 'Navami', 'Dashami',
  'Ekadashi', 'Dwadashi', 'Trayodashi', 'Chaturdashi', 'Purnima/Amavasya'
];

/**
 * Compute the engine's tithi for a given date/location
 */
function computeEngineTithi(dateISO: string, location: RefLocation): {
  tithiName: string;
  tithiNumber: number;
  paksha: string;
  sunrise: string;
  sunset: string;
  lunarMonth: string;
} {
  const engine = createPanchangEngine(location);
  const [y, m, d] = dateISO.split('-').map(Number);
  const date = new Date(y, m - 1, d);
  const panchang = engine.calculate(date);

  // Get the tithi name from the known array
  // The engine stores Tithi number 1-15, and name comes from TITHI_NAMES[tithiNumber-1]
  // For Amavasya/Purnima, the name is 'Purnima/Amavasya'
  const tithiNum = panchang.tithi.number;

  return {
    tithiName: panchang.tithi.name,
    tithiNumber: tithiNum,
    paksha: panchang.tithi.paksha,
    sunrise: fmtTime(panchang.sunrise),
    sunset: fmtTime(panchang.sunset),
    lunarMonth: 'pending',
  };
}

// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------

describe('Drik Panchang Comparison — Tithi Accuracy', () => {
  // Track statistics
  let totalTests = 0;
  let passedTests = 0;
  let failedTests: { label: string; expected: string; got: string }[] = [];

  for (const ref of DRIK_REFERENCES) {
    it(`${ref.dateISO} ${ref.location.name}: ${ref.drikPaksha} ${ref.drikTithi} (#${ref.drikNumber})`, () => {
      totalTests++;
      const result = computeEngineTithi(ref.dateISO, ref.location);

      // Handle Purnima/Amavasya naming — the engine uses 'Purnima/Amavasya' as name
      // Drik Panchang says 'Purnima' or 'Amavasya' specifically
      let engineName = result.tithiName;
      if (engineName === 'Purnima/Amavasya') {
        // Determine which one based on paksha
        engineName = result.paksha === 'Shukla' ? 'Purnima' : 'Amavasya';
      }

      const expectedName = ref.drikTithi;
      const match = engineName === expectedName && result.paksha === ref.drikPaksha;

      if (!match) {
        failedTests.push({
          label: `${ref.dateISO} ${ref.location.name}`,
          expected: `${ref.drikPaksha} ${ref.drikTithi} (#${ref.drikNumber})`,
          got: `${result.paksha} ${result.tithiName} (#${result.tithiNumber})`,
        });
      }

      // Allow Purnima/Amavasya to match either way since Drik says 'Purnima' or 'Amavasya'
      // but engine internally names both as index 14-15
      if (ref.drikTithi === 'Purnima' || ref.drikTithi === 'Amavasya') {
        // Just check that the tithi number is 15 and paksha matches
        expect(result.tithiNumber).toBe(15);
        expect(result.paksha).toBe(ref.drikPaksha);
      } else {
        expect(engineName).toBe(ref.drikTithi);
        expect(result.paksha).toBe(ref.drikPaksha);
      }

      passedTests++;
    });
  }

  // Print summary after all tests
  afterAll(() => {
    const accuracy = totalTests > 0 ? (passedTests / totalTests * 100).toFixed(1) : 'N/A';

    console.log('\n========================================');
    console.log('  DRIK PANCHANG COMPARISON RESULTS');
    console.log('========================================');
    console.log(`  Total references : ${totalTests}`);
    console.log(`  Passed           : ${passedTests}`);
    console.log(`  Failed           : ${failedTests.length}`);
    console.log(`  Accuracy         : ${accuracy}%`);
    console.log('========================================\n');

    if (failedTests.length > 0) {
      console.log('FAILED REFERENCES:');
      console.log('------------------');
      for (const f of failedTests) {
        console.log(`  ${f.label}`);
        console.log(`    Expected: ${f.expected}`);
        console.log(`    Got:      ${f.got}`);
      }
      console.log();
    } else {
      console.log('  ✅ ALL REFERENCES MATCH!');
      console.log();
    }
  });
});

// ---------------------------------------------------------------------------
// Detailed Probe — Full panchang output for specific key dates
// ---------------------------------------------------------------------------

describe('Drik Panchang Comparison — Detailed Probe', () => {
  const PROBE_DATES = [
    '2025-01-13', // Makar Sankranti
    '2025-02-27', // Maha Shivratri
    '2025-03-14', // Holi
    '2025-04-13', // Hanuman Jayanti/Purnima
    '2025-08-16', // Janmashtami
  ];

  const engine = createPanchangEngine(BANGALORE);

  for (const dateISO of PROBE_DATES) {
    it(`probe: ${dateISO} Bangalore`, () => {
      const [y, m, d] = dateISO.split('-').map(Number);
      const date = new Date(y, m - 1, d);
      const p = engine.calculate(date);

      console.log(`\n--- Probe: ${dateISO} (${p.location.name}) ---`);
      console.log(`  Sunrise : ${fmtTime(p.sunrise)}  Sunset: ${fmtTime(p.sunset)}`);
      console.log(`  Tithi   : ${p.tithi.paksha} ${p.tithi.name} (#${p.tithi.number})`);
      console.log(`  Start   : ${fmtTime(p.tithi.startTime)}`);
      console.log(`  End     : ${fmtTime(p.tithi.endTime)}`);
      console.log(`  Nakshatra: ${p.nakshatra.name} (#${p.nakshatra.number})`);
      console.log(`  Yoga    : ${p.yoga.name} (#${p.yoga.number})`);
      console.log(`  Karana  : ${p.karana.name} (#${p.karana.number})`);
      console.log(`  Var     : ${p.var.name}`);
      console.log(`  Raahu   : ${fmtTime(p.rahuKaal.start)}–${fmtTime(p.rahuKaal.end)}`);
      console.log(`  Yamaganda: ${fmtTime(p.yamagandam.start)}–${fmtTime(p.yamagandam.end)}`);
      console.log(`  Gulika  : ${fmtTime(p.gulikaKaal.start)}–${fmtTime(p.gulikaKaal.end)}`);
      console.log(`  Festivals: ${p.festivals.map(f => f.name).join(', ') || 'none'}`);
      console.log(`  Fasting : ${p.fasting?.name || 'none'}`);
      console.log(`  Samvatsara: ${p.samvatsara}`);
    });
  }
});

// ---------------------------------------------------------------------------
// Sunrise accuracy against Drik Panchang
// ---------------------------------------------------------------------------

describe('Drik Panchang Comparison — Sunrise Accuracy', () => {
  const data = DRIK_REFERENCES.filter(r => r.drikSunrise);

  for (const ref of data) {
    it(`sunrise ${ref.dateISO} ${ref.location.name} (expected ${ref.drikSunrise})`, () => {
      const [y, m, d] = ref.dateISO.split('-').map(Number);
      const date = new Date(y, m - 1, d);
      const sunrise = calculateSunrise(date, ref.location);

      const actualMinutes = sunrise.getHours() * 60 + sunrise.getMinutes();
      const [expH, expM] = ref.drikSunrise!.split(':').map(Number);
      const expectedMinutes = expH * 60 + expM;

      const diff = Math.abs(actualMinutes - expectedMinutes);
      expect(diff).toBeLessThanOrEqual(ref.toleranceMin);
    });
  }
});

// ---------------------------------------------------------------------------
// Sunset accuracy against Drik Panchang
// ---------------------------------------------------------------------------

describe('Drik Panchang Comparison — Sunset Accuracy', () => {
  const data = DRIK_REFERENCES.filter(r => r.drikSunset);

  for (const ref of data) {
    it(`sunset ${ref.dateISO} ${ref.location.name} (expected ${ref.drikSunset})`, () => {
      const [y, m, d] = ref.dateISO.split('-').map(Number);
      const date = new Date(y, m - 1, d);
      const sunset = calculateSunset(date, ref.location);

      const actualMinutes = sunset.getHours() * 60 + sunset.getMinutes();
      const [expH, expM] = ref.drikSunset!.split(':').map(Number);
      const expectedMinutes = expH * 60 + expM;

      const diff = Math.abs(actualMinutes - expectedMinutes);
      expect(diff).toBeLessThanOrEqual(ref.toleranceMin);
    });
  }
});

