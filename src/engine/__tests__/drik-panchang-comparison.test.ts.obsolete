    '2025-03-25': { tithi: 'Ekadashi', paksha: 'Krishna' },
    '2025-03-26': { tithi: 'Dwadashi', paksha: 'Krishna' },
    '2025-03-27': { tithi: 'Trayodashi', paksha: 'Krishna' },
    '2025-03-28': { tithi: 'Chaturdashi', paksha: 'Krishna' },
    '2025-03-29': { tithi: 'Amavasya', paksha: 'Krishna' },
    '2025-03-30': { tithi: 'Pratipada', paksha: 'Shukla' },
    '2025-03-31': { tithi: 'Dwitiya', paksha: 'Shukla' },
  };

  let passCount = 0;
  let failCount = 0;
  const failures: string[] = [];

  for (const [dateISO, drik] of Object.entries(drikData)) {
    it(`March ${dateISO.slice(8)}: engine=${drik.paksha} ${drik.tithi}`, () => {
      const [y, m, d] = dateISO.split('-').map(Number);
      const date = new Date(y, m - 1, d);
      const p = engine.calculate(date);

      // Normalize Purnima/Amavasya
      let engineName = p.tithi.name;
      if (engineName === 'Purnima/Amavasya') {
        engineName = p.tithi.paksha === 'Shukla' ? 'Purnima' : 'Amavasya';
      }

      if (engineName === drik.tithi && p.tithi.paksha === drik.paksha) {
        passCount++;
      } else {
        failCount++;
        failures.push(`  ${dateISO}: expected ${drik.paksha} ${drik.tithi}, got ${p.tithi.paksha} ${engineName}`);
      }

      expect(engineName).toBe(drik.tithi);
      expect(p.tithi.paksha).toBe(drik.paksha);
    });
  }

  afterAll(() => {
    const total = passCount + failCount;
    const pct = total > 0 ? ((passCount / total) * 100).toFixed(1) : 'N/A';

    console.log('\n========================================');
    console.log('  MARCH 2025 FULL MONTH COMPARISON');
    console.log('========================================');
    console.log(`  Days checked : ${total}`);
    console.log(`  Passed       : ${passCount}`);
    console.log(`  Failed       : ${failCount}`);
    console.log(`  Accuracy     : ${pct}%`);
    if (failCount > 0) {
      console.log('\n  FAILURES:');
      for (const f of failures) {
        console.log(f);
      }
    }
    console.log('========================================\n');
  });
});
